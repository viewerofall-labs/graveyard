#!/usr/bin/env bash
# mama — YoMom Linux package manager (official repos via pacman)
set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info()  { echo -e "${CYAN}::${RESET} $*"; }
ok()    { echo -e "${GREEN}✓${RESET} $*"; }
warn()  { echo -e "${YELLOW}!${RESET} $*"; }
die()   { echo -e "${RED}💀${RESET} yo mama so dumb she ${*}" >&2; exit 1; }

usage() {
    echo -e "${BOLD}mama${RESET} — YoMom Linux package manager (official repos)"
    echo
    echo -e "  ${BOLD}mama get${RESET} <pkg...>      install packages"
    echo -e "  ${BOLD}mama yeet${RESET} <pkg...>     remove packages"
    echo -e "  ${BOLD}mama yeet -nuke${RESET} <pkg>  remove package + dependencies"
    echo -e "  ${BOLD}mama upgrade${RESET}            upgrade all packages"
    echo -e "  ${BOLD}mama search${RESET} <term>      search official repos"
    echo -e "  ${BOLD}mama info${RESET} <pkg>         show package info"
    echo -e "  ${BOLD}mama list${RESET}               list installed packages"
    echo -e "  ${BOLD}mama owns${RESET} <file>        which package owns this file"
    echo -e "  ${BOLD}mama clean${RESET}              clean package cache"
    echo -e "  ${BOLD}mama check${RESET}              check for updates (no install)"
    echo
    echo -e "  For AUR packages, use ${BOLD}dada${RESET}"
    exit 0
}

need_root() {
    [[ $EUID -eq 0 ]] || die "thought she could run this without sudo. Try: sudo mama $*"
}

[[ $# -eq 0 ]] && usage

CMD="$1"; shift || true

case "$CMD" in
    get)
        [[ $# -eq 0 ]] && die "forgot to name the packages, genius"
        need_root get "$@"
        info "yo mama's getting: $*"
        pacman -S "$@"
        ok "done — yo mama got that"
        ;;

    yeet)
        [[ $# -eq 0 ]] && die "forgot to name what to yeet, idiot"
        need_root yeet "$@"
        if [[ "${1:-}" == "-nuke" ]]; then
            shift
            info "nuking $* and all its deps..."
            pacman -Rns "$@"
        else
            info "yeeting: $*"
            pacman -R "$@"
        fi
        ok "yeeted — gone forever"
        ;;

    upgrade)
        need_root upgrade
        info "yo mama's upgrading the whole damn system..."
        pacman -Syu
        ok "system upgraded — yo mama's glowing up"
        ;;

    search)
        [[ $# -eq 0 ]] && die "forgot what to search for, dumbass"
        info "searching official repos for: $*"
        pacman -Ss "$@"
        ;;

    info)
        [[ $# -eq 0 ]] && die "forgot the package name"
        # Try installed first, then remote
        pacman -Qi "$@" 2>/dev/null || pacman -Si "$@"
        ;;

    list)
        if [[ "${1:-}" == "-explicit" ]]; then
            info "explicitly installed packages:"
            pacman -Qe
        elif [[ "${1:-}" == "-foreign" ]]; then
            info "foreign (AUR/manual) packages:"
            pacman -Qm
        else
            info "all installed packages:"
            pacman -Q
        fi
        ;;

    owns)
        [[ $# -eq 0 ]] && die "forgot the file path"
        pacman -Qo "$@"
        ;;

    clean)
        need_root clean
        info "cleaning package cache..."
        pacman -Sc
        ok "cache cleaned — yo mama tidied up"
        ;;

    check)
        info "checking for updates (not installing)..."
        pacman -Qu || echo -e "${GREEN}already up to date — yo mama's on top of it${RESET}"
        ;;

    *)
        die "typed '${CMD}' and expected it to work. Run: mama"
        ;;
esac
